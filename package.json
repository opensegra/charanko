{
	"name": "charanko",
	"version": "0.1.0",
	"description": "Media download engine for Node: HTTP and HLS streams with fallbacks, AES-128, KVS links and FFmpeg remux, to disk or as a stream",
	"keywords": [
		"charanko",
		"download",
		"downloader",
		"hls",
		"m3u8",
		"stream",
		"video",
		"ffmpeg",
		"remux",
		"kvs",
		"segra"
	],
	"author": "OpenSegra",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/opensegra/charanko.git"
	},
	"homepage": "https://github.com/opensegra/charanko#readme",
	"bugs": {
		"url": "https://github.com/opensegra/charanko/issues"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"./client": {
			"import": {
				"types": "./dist/client/index.d.mts",
				"default": "./dist/client/index.mjs"
			},
			"require": {
				"types": "./dist/client/index.d.ts",
				"default": "./dist/client/index.js"
			}
		},
		"./contracts": {
			"import": {
				"types": "./dist/contracts/index.d.mts",
				"default": "./dist/contracts/index.mjs"
			},
			"require": {
				"types": "./dist/contracts/index.d.ts",
				"default": "./dist/contracts/index.js"
			}
		},
		"./downloader": {
			"import": {
				"types": "./dist/downloader/index.d.mts",
				"default": "./dist/downloader/index.mjs"
			},
			"require": {
				"types": "./dist/downloader/index.d.ts",
				"default": "./dist/downloader/index.js"
			}
		},
		"./storage": {
			"import": {
				"types": "./dist/storage/index.d.mts",
				"default": "./dist/storage/index.mjs"
			},
			"require": {
				"types": "./dist/storage/index.d.ts",
				"default": "./dist/storage/index.js"
			}
		},
		"./types": {
			"import": {
				"types": "./dist/types/index.d.mts",
				"default": "./dist/types/index.mjs"
			},
			"require": {
				"types": "./dist/types/index.d.ts",
				"default": "./dist/types/index.js"
			}
		},
		"./utils": {
			"import": {
				"types": "./dist/utils/index.d.mts",
				"default": "./dist/utils/index.mjs"
			},
			"require": {
				"types": "./dist/utils/index.d.ts",
				"default": "./dist/utils/index.js"
			}
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"test": "tsup && node --test tests/*.test.mjs",
		"lint:test": "eslint src",
		"lint:fix": "eslint --fix src",
		"format": "prettier --write 'src/**/*.ts'",
		"prepare": "pnpm run build",
		"prepublishOnly": "pnpm run typecheck && pnpm run lint:test && pnpm test",
		"pack:dry-run": "npm pack --dry-run",
		"release": "bash scripts/release",
		"release:major": "bash scripts/release major",
		"release:minor": "bash scripts/release minor",
		"release:patch": "bash scripts/release patch",
		"publish:npm": "pnpm publish --access public",
		"release:tag": "git fetch -q origin main && git merge-base --is-ancestor HEAD origin/main && VERSION=v$(node -p \"require('./package.json').version\") && git tag -a \"$VERSION\" -m \"$VERSION\" && git push origin \"$VERSION\"",
		"release:prepare": "standard-version --skip.tag",
		"release:prepare:major": "standard-version --release-as major --skip.tag",
		"release:dry-run": "standard-version --dry-run",
		"publish:github": "TARBALL=$(npm pack --silent | tail -1) && gh release create v$(node -p \"require('./package.json').version\") \"$TARBALL\" --generate-notes && rm -f \"$TARBALL\""
	},
	"engines": {
		"node": ">=22.12"
	},
	"license": "MIT",
	"packageManager": "pnpm@10.27.0",
	"dependencies": {
		"inumaki": "^0.6.0",
		"ffmpeg-static": "^5.3.0",
		"undici": "^8.12.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^25.9.9",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"prettier": "^3.9.10",
		"standard-version": "^9.5.0",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "8.60.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
